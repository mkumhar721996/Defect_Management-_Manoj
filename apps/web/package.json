{
  "name": "comp-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "22" },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
